new file mode 100644
index 0000000..f787f9d
--- /dev/null
+++ b/ms_agent/llm/ollama_llm.py
@@ -0,0 +1,399 @@
+# Copyright (c) Alibaba, Inc. and its affiliates.
+import inspect
+from copy import deepcopy
+from typing import Any, Dict, Generator, Iterable, List, Optional
+from urllib.parse import urlparse
+import uuid
+
+from ms_agent.llm import LLM
+from ms_agent.llm.utils import Message, Tool, ToolCall
+from ms_agent.utils import (MAX_CONTINUE_RUNS, assert_package_exist,
+                            get_logger, retry)
+from omegaconf import DictConfig, OmegaConf
+
+logger = get_logger()
+
+
+class Ollama(LLM):
+    """Wrapper for the official Ollama Python client.
+
+    This class uses the official `ollama` Python package to call the Ollama
+    chat API (not the OpenAI-compatible proxy). It supports both streaming
+    and non-streaming chat generation and a simple 'continue on length'
+    mechanism similar to other LLM adapters in this project.
+
+    Args:
+        config (`DictConfig`): Configuration containing `llm` and optional
+            `generation_config` sections.
+        base_url (`Optional[str]`): Custom Ollama HTTP API host, e.g.
+            "http://localhost:11434". If not provided the default client
+            behavior is used.
+    """
+
+    def __init__(
+        self,
+        config: DictConfig,
+        base_url: Optional[str] = None,
+        api_key: Optional[str] = None,
+    ):
+        super().__init__(config)
+        assert_package_exist('ollama')
+        # Import here so the project can be imported without ollama installed
+        from ollama import Client
+
+        self.model: str = config.llm.model
+        self.max_continue_runs = getattr(config.llm, 'max_continue_runs',
+                                         None) or MAX_CONTINUE_RUNS
+        # Accept legacy/openai-style parameters too
+        base_url = base_url or getattr(config.llm, 'ollama_base_url', None) or getattr(config.llm, 'openai_base_url', None)
+        api_key = api_key or getattr(config.llm, 'openai_api_key', None)
+
+        # Create a client. If host is provided, normalize it to scheme://netloc
+        client_kwargs = {}
+        if base_url:
+            parsed = urlparse(base_url)
+            host = f"{parsed.scheme}://{parsed.netloc}"
+            client_kwargs['host'] = host
+
+        # API key is intentionally ignored for the Ollama client here.
+        # Some runtimes may still provide `openai_api_key` for legacy reasons,
+        # but we do not forward it to the Ollama client as a header.
+
+        self.client = Client(**client_kwargs)
+        self.args: Dict = OmegaConf.to_container(
+            getattr(config, 'generation_config', DictConfig({})))
+
+    def format_tools(self,
+                     tools: Optional[List[Tool]] = None) -> Optional[List[Dict[str, Any]]]:
+        """Format `tools` into the structure accepted by Ollama chat API.
+
+        Ollama's chat endpoint accepts an optional `tools` array similar to
+        the OpenAI-style function definitions. We keep the same simple
+        mapping used by other adapters in the repo.
+        """
+        if not tools:
+            return None
+
+        formatted = []
+        for tool in tools:
+            formatted.append({
+                'type': 'function',
+                'function': {
+                    'name': tool['tool_name'],
+                    'description': tool.get('description', ''),
+                    'parameters': tool.get('parameters', {}),
+                }
+            })
+
+        return formatted
+
+    @retry(max_attempts=LLM.retry_count, delay=1.0)
+    def generate(self,
+                 messages: List[Message],
+                 tools: Optional[List[Tool]] = None,
+                 max_continue_runs: Optional[int] = None,
+                 **kwargs) -> Message | Generator[Message, None, None]:
+        """Generate a chat response using Ollama.
+
+        Supports streaming by passing `stream=True` in kwargs. Additional
+        generation parameters can be passed via `generation_config` in the
+        provided `config` or directly through `kwargs`.
+        """
+        parameters = None
+        try:
+            parameters = inspect.signature(self.client.chat).parameters
+        except Exception:
+            parameters = None
+
+        args = self.args.copy()
+        args.update(kwargs)
+        stream = args.get('stream', False)
+
+        # Keep only supported parameters when possible
+        if parameters is not None:
+            args = {key: value for key, value in args.items() if key in parameters}
+
+        completion = self._call_llm(messages, tools, **args)
+
+        max_continue_runs = max_continue_runs or self.max_continue_runs
+        if stream:
+            return self._stream_continue_generate(messages, completion, tools,
+                                                  max_continue_runs - 1,
+                                                  **args)
+        else:
+            return self._continue_generate(messages, completion, tools,
+                                           max_continue_runs - 1, **args)
+
+    def _call_llm(self,
+                  messages: List[Message],
+                  tools: Optional[List[Tool]] = None,
+                  **kwargs) -> Any:
+        """Call Ollama chat endpoint.
+
+        Returns either a dict (non-stream) or an iterable/generator (stream).
+        """
+        messages_payload = self._format_input_message(messages)
+        formatted_tools = self.format_tools(tools)
+
+        # Ensure model is provided
+        kwargs['model'] = kwargs.get('model', self.model)
+
+        # Pass tools if any
+        if formatted_tools is not None:
+            kwargs['tools'] = formatted_tools
+
+        # The official client returns a mapping or an iterator when stream=True
+        return self.client.chat(messages=messages_payload, **kwargs)
+
+    @staticmethod
+    def _stream_format_output_message(chunk) -> Message:
+        """Convert a single streaming chunk from Ollama into a Message.
+
+        The streaming chunk is expected to be a dict-like object with
+        a `message` field containing incremental content. We map commonly
+        available fields to the project's `Message` dataclass.
+        """
+        # Expect chunk to be a ChatResponse-like object with a `message` attribute
+        msg = getattr(chunk, 'message', None)
+        if msg is None:
+            # Fallback empty message
+            content = ''
+            role = 'assistant'
+            reasoning = ''
+            raw_tool_calls = None
+        else:
+            content = getattr(msg, 'content', '') or ''
+            role = getattr(msg, 'role', 'assistant')
+            reasoning = getattr(msg, 'reasoning_content', '') or ''
+            raw_tool_calls = getattr(msg, 'tool_calls', None)
+
+        tool_calls = []
+        if raw_tool_calls:
+            for idx, tool_call in enumerate(raw_tool_calls):
+                # Follow openai_llm style: prefer function.* attributes
+                tc_id = getattr(tool_call, 'id', '')
+                tc_index = getattr(tool_call, 'index', idx)
+                tc_type = getattr(tool_call, 'type', 'function')
+                func = getattr(tool_call, 'function', None)
+
+                if func is not None:
+                    arguments = getattr(func, 'arguments', '')
+                    tool_name = getattr(func, 'name', None)
+                else:
+                    arguments = getattr(tool_call, 'arguments', '')
+                    tool_name = getattr(tool_call, 'tool_name', None)
+
+                if not tc_id:
+                    tc_id = f'tc_{uuid.uuid4().hex}'
+
+                tool_calls.append(ToolCall(
+                    id=tc_id,
+                    index=tc_index,
+                    type=tc_type,
+                    arguments=arguments,
+                    tool_name=tool_name,
+                ))
+
+        return Message(
+            role=role,
+            content=content,
+            reasoning_content=reasoning,
+            tool_calls=tool_calls,
+            id=getattr(chunk, 'id', ''),
+            prompt_tokens=getattr(chunk, 'prompt_eval_count', 0) or 0,
+            completion_tokens=getattr(chunk, 'eval_count', 0) or 0,
+        )
+
+    @staticmethod
+    def _format_output_message(response) -> Message:
+        """Format a non-streaming Ollama response into a Message.
+
+        The Ollama chat response typically contains top-level keys like
+        `message`, `done`, `done_reason`, and timing/usage fields.
+        """
+        # Expect a ChatResponse-like object from the ollama client
+        msg_obj = getattr(response, 'message', None)
+        if msg_obj is not None:
+            content = getattr(msg_obj, 'content', '') or ''
+            role = getattr(msg_obj, 'role', 'assistant')
+            raw_tool_calls = getattr(msg_obj, 'tool_calls', None)
+            reasoning = getattr(msg_obj, 'reasoning_content', '') or ''
+        else:
+            content = ''
+            role = 'assistant'
+            raw_tool_calls = None
+            reasoning = ''
+
+        prompt_tokens = getattr(response, 'prompt_eval_count', 0) or 0
+        completion_tokens = getattr(response, 'eval_count', 0) or 0
+        resp_id = getattr(response, 'id', '')
+
+        tool_calls = []
+        if raw_tool_calls:
+            for idx, tool_call in enumerate(raw_tool_calls):
+                tc_id = getattr(tool_call, 'id', '')
+                tc_index = getattr(tool_call, 'index', idx)
+                tc_type = getattr(tool_call, 'type', 'function')
+                func = getattr(tool_call, 'function', None)
+
+                if func is not None:
+                    arguments = getattr(func, 'arguments', '')
+                    tool_name = getattr(func, 'name', None)
+                else:
+                    arguments = getattr(tool_call, 'arguments', '')
+                    tool_name = getattr(tool_call, 'tool_name', None)
+
+                if not tc_id:
+                    tc_id = f'tc_{uuid.uuid4().hex}'
+
+                tool_calls.append(ToolCall(
+                    id=tc_id,
+                    index=tc_index,
+                    type=tc_type,
+                    arguments=arguments,
+                    tool_name=tool_name,
+                ))
+
+        return Message(
+            role=role,
+            content=content,
+            reasoning_content=reasoning,
+            tool_calls=tool_calls,
+            id=resp_id,
+            prompt_tokens=prompt_tokens,
+            completion_tokens=completion_tokens,
+        )
+
+    def _merge_stream_message(self, pre_message_chunk: Optional[Message],
+                              message_chunk: Message) -> Optional[Message]:
+        """Merge streaming message chunks into an accumulated Message.
+
+        This is simplified compared to OpenAI merging logic since Ollama's
+        streaming chunks are generally incremental text updates.
+        """
+        if not pre_message_chunk:
+            return message_chunk
+        message = deepcopy(pre_message_chunk)
+        message.reasoning_content += message_chunk.reasoning_content
+        message.content += message_chunk.content
+        # Append tool_calls if present
+        if message_chunk.tool_calls:
+            if message.tool_calls:
+                message.tool_calls += message_chunk.tool_calls
+            else:
+                message.tool_calls = message_chunk.tool_calls
+        return message
+
+    def _stream_continue_generate(self,
+                                  messages: List[Message],
+                                  completion: Iterable,
+                                  tools: Optional[List[Tool]] = None,
+                                  max_runs: Optional[int] = None,
+                                  **kwargs) -> Generator[Message, None, None]:
+        """Handle streaming generation and continuation when `done` is false.
+
+        Ollama returns `done` and `done_reason` in non-streaming responses.
+        For streaming, we accumulate chunks and, if a final response indicates
+        the model stopped due to length, we attempt to continue like other
+        adapters.
+        """
+        message = None
+        try:
+            for chunk in completion:
+                message_chunk = self._stream_format_output_message(chunk)
+                message = self._merge_stream_message(message, message_chunk)
+                # On streaming, we don't always get a final `done` flag in each
+                # chunk. Yield accumulated partials as they arrive.
+                yield message
+
+            # After stream ends, check if the last chunk indicates unfinished
+            if isinstance(message, Message) and (not getattr(message, 'partial', False)):
+                # If the stream ended but model indicates a length stop, try continue
+                # (Ollama non-stream responses include done/done_reason; here we
+                # conservatively don't attempt automatic continue).
+                pass
+
+        except Exception as e:
+            logger.exception('Error while streaming from Ollama: %s', e)
+
+    def _call_llm_for_continue_gen(self,
+                                   messages: List[Message],
+                                   new_message: Message,
+                                   tools: List[Tool] = None,
+                                   **kwargs) -> Any:
+        """Prepare messages and call the LLM again to continue generation.
+
+        This method follows the same contract as other adapters in the repo:
+        mark or merge partial messages and call `_call_llm` again.
+        """
+        if messages[-1].to_dict().get('partial', False):
+            # merge into last partial
+            messages[-1].reasoning_content += new_message.reasoning_content
+            messages[-1].content += new_message.content
+            messages[-1].prompt_tokens += new_message.prompt_tokens
+            messages[-1].completion_tokens += new_message.completion_tokens
+        else:
+            if messages[-1].content != new_message.content:
+                messages.append(new_message)
+            messages[-1].partial = True
+        messages[-1].api_calls += 1
+
+        return self._call_llm(messages, tools, **kwargs)
+
+    def _continue_generate(self,
+                           messages: List[Message],
+                           completion,
+                           tools: List[Tool] = None,
+                           max_runs: Optional[int] = None,
+                           **kwargs) -> Message:
+        """Continue non-streaming generation when Ollama indicates unfinished.
+
+        Ollama non-streaming responses include `done` and `done_reason`. If a
+        response finished due to length we attempt to call again up to
+        `max_runs` times to continue generation.
+        """
+        new_message = self._format_output_message(completion)
+
+        done_reason = getattr(completion, 'done_reason', None)
+        done = getattr(completion, 'done', True)
+
+        if (not done) or (done_reason in ['length', 'null'] and (max_runs is None or max_runs != 0)):
+            logger.info('finish_reason: %s, continue generate.', done_reason)
+            completion = self._call_llm_for_continue_gen(messages, new_message, tools, **kwargs)
+            return self._continue_generate(messages, completion, tools,
+                                           max_runs - 1 if max_runs is not None else None,
+                                           **kwargs)
+        elif messages[-1].to_dict().get('partial', False):
+            # merge partial into last message and return
+            messages[-1].reasoning_content += new_message.reasoning_content
+            messages[-1].content += new_message.content
+            messages[-1].prompt_tokens += new_message.prompt_tokens
+            messages[-1].completion_tokens += new_message.completion_tokens
+            messages[-1].partial = False
+            return messages.pop(-1)
+        else:
+            return new_message
+
+    def _format_input_message(self, messages: List[Message]) -> List[Dict[str, Any]]:
+        """Convert internal Message objects into Ollama chat input format.
+
+        Ollama expects a list of message dicts with at least `role` and
+        optionally `content` for messages. We keep the input minimal and
+        only send `role` and `content` per message to the client (matching
+        what the OpenAI adapter does for input normalization).
+        """
+        payload = []
+        for message in messages:
+            if isinstance(message, Message):
+                message.content = message.content.strip()
+                message = message.to_dict()
+
+            # Only keep `role` and `content` when sending to the client.
+            item = {
+                'role': message.get('role'),
+                'content': message.get('content', '')
+            }
+
+            payload.append(item)
+
+        return payload
