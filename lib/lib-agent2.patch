+def normalize_json_escaped_string(s: str, max_depth: int = 3) -> str:
+    """
+    Safely decode a string that may have been JSON-escaped multiple times.
+
+    Examples:
+        >>> normalize_json_escaped_string('function {...}')  # unchanged
+        >>> normalize_json_escaped_string('function {...}\\n')  # decode once
+        >>> normalize_json_escaped_string('function {...}\\\\n')  # decode twice
+
+    Args:
+        s (str): The possibly escaped string.
+        max_depth (int): Maximum decoding attempts to avoid infinite loops.
+
+    Returns:
+        str: The normalized, human-readable string.
+    """
+    if not isinstance(s, str):
+        return s
+
+    decoded = s
+    for _ in range(max_depth):
+        try:
+            # Try to interpret it as a JSON string literal
+            temp = json.loads(f'"{decoded}"')
+            # If decoding changes the string, keep going
+            if temp == decoded:
+                break
+            decoded = temp
+        except json.JSONDecodeError:
+            break
+    return decoded
